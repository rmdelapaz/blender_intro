                                    <rect x="300" y="150" width="500" height="38" rx="7" fill="#1a1a1f" fill-opacity="0.9"/>
                                    <text x="318" y="177" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="700" fill="#ffffff">3D Viewport &#183; see materials in real-time</text>
                                    <line x1="560" y1="188" x2="660" y2="250" stroke="#FF6B00" stroke-width="3" stroke-linecap="round"/>
                                    <circle cx="665" cy="255" r="7" fill="#FF6B00"/>
                                </g>
                                <g>
                                    <rect x="250" y="690" width="512" height="38" rx="7" fill="#1a1a1f" fill-opacity="0.9"/>
                                    <text x="268" y="717" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Shader Editor &#183; build material nodes here</text>
                                    <line x1="506" y1="690" x2="540" y2="600" stroke="#FF6B00" stroke-width="3" stroke-linecap="round"/>
                                    <circle cx="543" cy="592" r="7" fill="#FF6B00"/>
                                </g>
                                <g>
                                    <rect x="1290" y="690" width="452" height="38" rx="7" fill="#1a1a1f" fill-opacity="0.9"/>
                                    <text x="1308" y="717" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Properties Panel &#183; quick adjustments</text>
                                    <line x1="1450" y1="690" x2="1400" y2="430" stroke="#FF6B00" stroke-width="3" stroke-linecap="round"/>
