# INLINE SVG  · insert BEFORE the line `                    <h3>Why Metallic Should Be 0.0 or 1.0</h3>`
                    <figure>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 560" role="img" aria-labelledby="ca-title ca-desc" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">
                            <title id="ca-title">Conductor versus insulator electron behavior and light response</title>
                            <desc id="ca-desc">Two panels comparing how light interacts with matter at the atomic level. On the left, a conductor or metal shows a lattice of nuclei surrounded by a sea of free electrons that move between atoms. An incoming light wave meets these free electrons and is immediately re-emitted as reflection, so almost no light enters. On the right, an insulator or non-metal shows electrons tightly bound in orbitals around each nucleus. The light wave is not stopped at the surface and passes between the atoms, giving transmission and scattering rather than strong reflection.</desc>
                            <!-- Top brand accent -->
                            <rect x="0" y="0" width="800" height="3" fill="#FF6B00"/>
                            <!-- Heading block -->
                            <text x="40" y="56" font-size="24" font-weight="700" fill="currentColor">Why Metals Reflect: Electrons and Light</text>
                            <text x="40" y="84" font-size="14" fill="currentColor" opacity="0.65">Free electrons re-emit light &#183; bound electrons let it pass</text>
                            <line x1="40" y1="108" x2="760" y2="108" stroke="currentColor" stroke-width="1" opacity="0.15"/>
                            <text x="220" y="148" font-size="16" font-weight="600" text-anchor="middle" fill="currentColor">Conductor &#183; Metal</text>
                            <text x="220" y="168" font-size="12.5" text-anchor="middle" fill="currentColor" opacity="0.6">Free electrons, immediate re-emission</text>
                            <!-- lattice region box -->
                            <rect x="80" y="196" width="280" height="220" rx="8" fill="currentColor" opacity="0.05"/>
                            <!-- nuclei lattice 3x3 -->
                            <!-- row 1 -->
                            <circle cx="140" cy="248" r="13" fill="#7C5CC4"/><circle cx="220" cy="248" r="13" fill="#7C5CC4"/><circle cx="300" cy="248" r="13" fill="#7C5CC4"/>
                            <!-- row 2 -->
                            <circle cx="140" cy="306" r="13" fill="#7C5CC4"/><circle cx="220" cy="306" r="13" fill="#7C5CC4"/><circle cx="300" cy="306" r="13" fill="#7C5CC4"/>
                            <!-- row 3 -->
                            <circle cx="140" cy="364" r="13" fill="#7C5CC4"/><circle cx="220" cy="364" r="13" fill="#7C5CC4"/><circle cx="300" cy="364" r="13" fill="#7C5CC4"/>
                            <!-- free electron sea (gold dots) scattered between nuclei -->
                            <g fill="#F5C242">
                                <circle cx="178" cy="270" r="5"/><circle cx="262" cy="262" r="5"/><circle cx="200" cy="300" r="5"/>
                                <circle cx="280" cy="300" r="5"/><circle cx="162" cy="334" r="5"/><circle cx="244" cy="340" r="5"/>
                                <circle cx="320" cy="332" r="5"/><circle cx="186" cy="392" r="5"/><circle cx="270" cy="388" r="5"/>
                                <circle cx="120" cy="288" r="5"/><circle cx="332" cy="276" r="5"/>
                            </g>
                            <!-- motion arrows showing electrons drifting freely -->
                            <g stroke="#F5C242" stroke-width="1.6" opacity="0.7">
                                <line x1="186" y1="270" x2="208" y2="266" marker-end="url(#ca-e)"/>
                                <line x1="252" y1="340" x2="230" y2="344" marker-end="url(#ca-e)"/>
                                <line x1="278" y1="392" x2="300" y2="388" marker-end="url(#ca-e)"/>
                            </g>
                            <!-- incoming light wave from upper-left, reflecting off the surface (no penetration) -->
                            <path d="M 60,176 q 10,-12 20,0 q 10,12 20,0 q 10,-12 20,0 q 10,12 20,0" fill="none" stroke="#E0506A" stroke-width="2.6"/>
                            <line x1="140" y1="176" x2="172" y2="192" stroke="#E0506A" stroke-width="2.6" marker-end="url(#ca-wave)"/>
                            <!-- reflected wave bouncing back up -->
                            <path d="M 176,196 q 12,-10 20,2 q 8,12 20,2 q 12,-10 20,2" fill="none" stroke="#FF6B00" stroke-width="2.6"/>
                            <line x1="236" y1="202" x2="266" y2="186" stroke="#FF6B00" stroke-width="2.6" marker-end="url(#ca-refl)"/>
                            <text x="300" y="186" font-size="11.5" fill="#FF6B00" font-weight="600">Reflected</text>
                            <text x="220" y="404" font-size="11.5" text-anchor="middle" fill="currentColor" opacity="0.6">Electrons roam freely between nuclei</text>
                            <text x="580" y="148" font-size="16" font-weight="600" text-anchor="middle" fill="currentColor">Insulator &#183; Non-Metal</text>
                            <text x="580" y="168" font-size="12.5" text-anchor="middle" fill="currentColor" opacity="0.6">Bound electrons, light passes through</text>
                            <rect x="440" y="196" width="280" height="220" rx="8" fill="currentColor" opacity="0.05"/>
                            <!-- atoms with bound electron orbits, 2x2 spaced -->
                            <!-- atom A -->
                            <circle cx="510" cy="260" r="12" fill="#7C5CC4"/>
                            <ellipse cx="510" cy="260" rx="30" ry="14" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
                            <circle cx="540" cy="260" r="4.5" fill="#F5C242"/>
                            <!-- atom B -->
                            <circle cx="650" cy="260" r="12" fill="#7C5CC4"/>
                            <ellipse cx="650" cy="260" rx="30" ry="14" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
                            <circle cx="620" cy="260" r="4.5" fill="#F5C242"/>
                            <!-- atom C -->
                            <circle cx="510" cy="356" r="12" fill="#7C5CC4"/>
                            <ellipse cx="510" cy="356" rx="30" ry="14" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
                            <circle cx="480" cy="356" r="4.5" fill="#F5C242"/>
                            <!-- atom D -->
                            <circle cx="650" cy="356" r="12" fill="#7C5CC4"/>
                            <ellipse cx="650" cy="356" rx="30" ry="14" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
                            <circle cx="680" cy="356" r="4.5" fill="#F5C242"/>
                            <!-- incoming light wave that penetrates between atoms (passes down through the gap) -->
                            <path d="M 452,182 q 10,-12 20,0 q 10,12 20,0 q 10,-12 20,0" fill="none" stroke="#E0506A" stroke-width="2.6"/>
                            <line x1="512" y1="182" x2="558" y2="206" stroke="#E0506A" stroke-width="2.6" marker-end="url(#ca-wave)"/>
                            <!-- continues between the atoms down into the material -->
                            <path d="M 580,222 q -12,12 0,22 q 12,12 0,22 q -12,12 0,22 q 12,12 0,22" fill="none" stroke="#E0506A" stroke-width="2.4" opacity="0.7"/>
                            <line x1="580" y1="332" x2="586" y2="384" stroke="#E0506A" stroke-width="2.4" opacity="0.7" marker-end="url(#ca-wave)"/>
                            <text x="600" y="400" font-size="11.5" fill="#4F9DDE" font-weight="600">Transmitted / scattered</text>
                            <!-- center divider -->
                            <line x1="400" y1="138" x2="400" y2="420" stroke="currentColor" stroke-width="1" opacity="0.12"/>
                            <!-- Legend -->
                            <rect x="40" y="440" width="720" height="50" rx="6" fill="currentColor" opacity="0.04"/>
                            <circle cx="74" cy="460" r="9" fill="#7C5CC4"/>
                            <text x="92" y="464" font-size="13" fill="currentColor">Nucleus</text>
                            <circle cx="196" cy="460" r="6" fill="#F5C242"/>
                            <text x="210" y="464" font-size="13" fill="currentColor">Electron</text>
                            <line x1="322" y1="460" x2="356" y2="460" stroke="#E0506A" stroke-width="2.6"/>
                            <text x="364" y="464" font-size="13" fill="currentColor">Incoming light</text>
                            <line x1="520" y1="460" x2="554" y2="460" stroke="#FF6B00" stroke-width="2.6"/>
                            <text x="562" y="464" font-size="13" fill="currentColor">Reflected light</text>
                            <text x="74" y="482" font-size="12" fill="currentColor" opacity="0.6">Free electrons make metals reflect almost everything &#183; bound electrons let non-metals transmit and scatter.</text>
                            <!-- Footer tip (Variant B left rail) -->
                            <rect x="40" y="506" width="4" height="34" fill="#FF6B00"/>
                            <text x="58" y="528" font-size="13" fill="currentColor">
                                <tspan font-weight="700" fill="#FF6B00">Tip:</tspan> This is why Metallic is a 0-or-1 switch &#183; a surface either has the free-electron sea or it does not.
                            </text>
                            <defs>
                                <marker id="ca-wave" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="#E0506A"/></marker>
                                <marker id="ca-refl" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="#FF6B00"/></marker>
                                <marker id="ca-e" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#F5C242"/></marker>
                            </defs>
                        </svg>
                        <figcaption>At the atomic level a material either has a sea of free electrons (a conductor) or it does not (an insulator). Free electrons re-emit incoming light as reflection, so metals reflect almost everything; bound electrons let light pass into non-metals, giving diffuse scattering. This binary physics is why Metallic is a 0-or-1 switch.</figcaption>
                    </figure>
